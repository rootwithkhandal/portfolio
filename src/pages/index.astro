---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Profile from '../components/Profile.astro';
import Projects from '../components/Projects.astro';
import Blogs from '../components/Blogs.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <!-- Custom cursor (pointer devices only) -->
  <div class="cursor"      id="cursor"     aria-hidden="true"></div>
  <div class="cursor-ring" id="cursorRing" aria-hidden="true"></div>

  <Nav />
  <Hero />
  <Profile />
  <Projects />
  <Blogs />
  <Contact />

  <footer>
    <div class="footer-logo">0x</div>
    <p>Priyansh Khandal · Cybersecurity Researcher · SOC Analyst · Pentester</p>
    <p class="footer-year">khandal.tech · 2026</p>
  </footer>
</Layout>

<style>
  footer {
    border-top: 0.5px solid var(--border);
    padding: clamp(1.2rem, 3vw, 2rem) clamp(1rem, 5vw, 3rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  footer p {
    font-family: var(--font-label);
    font-size: clamp(0.65rem, 1.2vw, 0.75rem);
    color: var(--muted);
    letter-spacing: 0.15em;
  }
  .footer-year { opacity: 0.5; }
  .footer-logo {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.2rem);
    letter-spacing: 0.1em;
    color: rgba(79,195,247,0.4);
  }

  @media (max-width: 480px) {
    footer { justify-content: center; text-align: center; }
  }
</style>

<script>
  /* ─────────────────────────────────────────
     1. CUSTOM CURSOR  (pointer devices only)
  ───────────────────────────────────────── */
  const cursor = document.getElementById('cursor') as HTMLElement;
  const ring   = document.getElementById('cursorRing') as HTMLElement;

  // Only activate on devices that support hover (not touch-only)
  const hasPointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (hasPointer && cursor && ring) {
    let mx = -200, my = -200;   // start off-screen
    let rx = -200, ry = -200;

    // Dot follows mouse instantly
    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY;
      cursor.style.left = mx + 'px';
      cursor.style.top  = my + 'px';
    });

    // Ring trails with lerp
    (function animRing() {
      rx += (mx - rx) * 0.11;
      ry += (my - ry) * 0.11;
      ring.style.left = rx + 'px';
      ring.style.top  = ry + 'px';
      requestAnimationFrame(animRing);
    })();

    // Hover state: dot shrinks, ring expands
    document.querySelectorAll('a, button, [role="button"]').forEach(el => {
      el.addEventListener('mouseenter', () => {
        cursor.style.width   = '5px';
        cursor.style.height  = '5px';
        cursor.style.opacity = '0.5';
        ring.style.width     = '52px';
        ring.style.height    = '52px';
        ring.style.borderColor = 'rgba(79,195,247,0.8)';
      });
      el.addEventListener('mouseleave', () => {
        cursor.style.width   = '10px';
        cursor.style.height  = '10px';
        cursor.style.opacity = '1';
        ring.style.width     = '36px';
        ring.style.height    = '36px';
        ring.style.borderColor = 'rgba(79,195,247,0.55)';
      });
    });

    // Click pulse
    document.addEventListener('mousedown', () => {
      cursor.style.transform = 'translate(-50%,-50%) scale(0.7)';
      ring.style.transform   = 'translate(-50%,-50%) scale(0.85)';
    });
    document.addEventListener('mouseup', () => {
      cursor.style.transform = 'translate(-50%,-50%) scale(1)';
      ring.style.transform   = 'translate(-50%,-50%) scale(1)';
    });
  }

  /* ─────────────────────────────────────────
     2. SCROLL-TRIGGERED FADE-UP  (.reveal)
  ───────────────────────────────────────── */
  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');

  const revealObserver = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);   // animate once
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  revealEls.forEach(el => revealObserver.observe(el));

  /* ─────────────────────────────────────────
     3. NAV ACTIVE STATE on scroll
  ───────────────────────────────────────── */
  const sections  = document.querySelectorAll<HTMLElement>('[id]');
  const navLinks  = document.querySelectorAll<HTMLAnchorElement>('.nav-links a');

  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(s => {
      if (window.scrollY >= s.offsetTop - 120) current = s.id;
    });
    navLinks.forEach(a => {
      a.classList.toggle('active', a.dataset.section === current);
    });
  }, { passive: true });

  /* ─────────────────────────────────────────
     4. PROFICIENCY BARS  (animate on reveal)
  ───────────────────────────────────────── */
  const barsContainer = document.querySelector('.lang-bar-wrap');
  if (barsContainer) {
    const barObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          document.querySelectorAll<HTMLElement>('.lang-fill').forEach(bar => {
            const target = bar.dataset.width + '%';
            // reset then animate
            bar.style.width = '0%';
            requestAnimationFrame(() => {
              requestAnimationFrame(() => { bar.style.width = target; });
            });
          });
          barObserver.disconnect();
        }
      });
    }, { threshold: 0.4 });
    barObserver.observe(barsContainer);
  }
</script>
