---
import ContentLayout from '../layouts/ContentLayout.astro';

const htmlContent = `
  <h1>Cookie Policy</h1>
  <p><strong>Last updated: September 4, 2026</strong></p>

  <div class="legal-summary" style="background: rgba(0,237,100,0.05); padding: 1rem; border-left: 3px solid var(--accent); margin: 2rem 0; border-radius: 4px;">
    <strong>Plain-Language Summary:</strong> This website is completely static. I do not set any tracking, advertising, or analytics cookies. You don't need a cookie banner here because there is nothing to opt out of.
  </div>
  
  <h2>1. What Are Cookies?</h2>
  <p>Cookies are small text files that are placed on your computer or mobile device when you visit a website. They are widely used to make websites work, or work more efficiently, as well as to provide information to the owners of the site.</p>

  <h2>2. How I Use Cookies</h2>
  <p><strong>I do not use them.</strong> This portfolio is built using Astro as a completely static site. It does not employ Google Analytics, Meta Pixels, session trackers, or third-party advertising cookies.</p>

  <h2>3. Controlling Cookies</h2>
  <p>Because I don't use cookies, there are no specific controls or opt-outs required for this site. However, you can generally control and manage cookies across the web using your browser settings.</p>

  <h2>4. Version History</h2>
  <ul>
    <li><strong>v1.0 (Sep 2026):</strong> Initial cookie policy published. Verified zero-cookie footprint.</li>
  </ul>

  <h2>5. Contact</h2>
  <p>For data or legal enquiries, please contact: <a href="mailto:legal@khandal.tech">legal@khandal.tech</a></p>
`;
---

<ContentLayout
  title="Cookie Policy"
  tag="Legal"
  tagColor="#a8b3bc"
  meta="Legal · Cookie Policy"
  backHref="/"
  backLabel="Home"
  htmlContent={htmlContent}
/>
