---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { projects } from '../../data/projects';

const tagColors: Record<string, string> = {
  'Bug Bounty':    '#00ed64',
  'AI Red-Team':   '#e53935',
  'Blockchain':    '#69f0ae',
  'SOC':           '#ff9800',
  'OPSEC':         '#80cbc4',
  'Multi-Model':   '#ce93d8',
  'Nix / DevOps':  '#4dd0e1',
  'Analytics':     '#ce93d8',
};

const tags = ['All', ...new Set(projects.map(p => p.tag))];
---

<Layout>
  <Nav />
  <main>
    <!-- Page header -->
    <div class="page-header">
      <div class="page-label">
        <span class="dot"></span>
        Research &amp; Projects
      </div>
      <h1 class="page-title">Active Operations</h1>
      <p class="page-sub">{projects.length} projects across offensive security, blockchain auditing, AI red-teaming, and OPSEC.</p>
    </div>

    <!-- Filter tabs -->
    <div class="filters" id="filters">
      {tags.map(tag => (
        <button class={`filter-btn ${tag === 'All' ? 'active' : ''}`} data-tag={tag}>
          {tag}
        </button>
      ))}
    </div>

    <!-- Projects grid -->
    <div class="projects-grid" id="projectsGrid">
      {projects.map(project => {
        const color = tagColors[project.tag] ?? '#00ed64';
        const repoName = project.githubRepo.split('/')[1] ?? project.slug;
        return (
          <a
            href={`/projects/${project.slug}`}
            class="project-card"
            data-tag={project.tag}
          >
            <!-- top bar accent -->
            <div class="card-accent" style={`background:${color}`}></div>

            <div class="card-body">
              <div class="card-top">
                <span class="card-tag" style={`color:${color};border-color:${color}28;background:${color}0d`}>
                  {project.tag}
                </span>
                <span class="card-repo">{repoName}</span>
              </div>

              <h2 class="card-title">{project.title}</h2>
              <p class="card-excerpt">{project.excerpt}</p>
            </div>

            <div class="card-footer">
              <span class="card-read">View Details</span>
              <svg class="card-arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>


          </a>
        );
      })}
    </div>

    <!-- Empty state (shown by JS when filter has no results) -->
    <div class="empty" id="emptyState" style="display:none">
      <p>No projects found for this filter.</p>
    </div>
  </main>

  <footer>
    <a href="/" class="logo">0x</a>
    <p>Priyansh Khandal · Cybersecurity Researcher</p>
    <p class="dim">2026</p>
  </footer>

</Layout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards      = document.querySelectorAll<HTMLElement>('.project-card');
  const empty      = document.getElementById('emptyState')!;

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const tag = btn.dataset.tag!;
      let visible = 0;

      cards.forEach(card => {
        const match = tag === 'All' || card.dataset.tag === tag;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });

      empty.style.display = visible === 0 ? 'block' : 'none';
    });
  });
</script>

<style>
  /* ── Main ── */
  main {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 5rem) clamp(1rem, 5vw, 3rem);
  }

  /* Page header */
  .page-header { margin-bottom: 3rem; }

  .page-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .dot {
    width: 6px; height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(1.5); }
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: 0.03em;
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .page-sub {
    font-family: var(--font-body);
    font-size: clamp(0.82rem, 1.4vw, 0.9rem);
    color: var(--muted);
    line-height: 1.7;
    max-width: 520px;
  }

  /* ── Filters ── */
  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 9999px;
    padding: 5px 14px;
    cursor: pointer;
    transition: color 0.2s, background 0.2s, border-color 0.2s;
    white-space: nowrap;
  }
  .filter-btn:hover {
    color: var(--accent);
    border-color: rgba(0,237,100,0.3);
    background: rgba(0,237,100,0.05);
  }
  .filter-btn.active {
    color: var(--accent);
    background: rgba(0,237,100,0.1);
    border-color: rgba(0,237,100,0.4);
  }

  /* ── Grid ── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  /* ── Card ── */
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bg2);
    border: 0.5px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, background 0.3s;
  }
  .project-card:hover {
    border-color: rgba(0,237,100,0.3);
    background: rgba(0,237,100,0.02);
    transform: translateY(-4px);
  }

  /* top colour bar */
  .card-accent {
    height: 2px;
    width: 100%;
    opacity: 0.7;
    transition: opacity 0.3s;
  }
  .project-card:hover .card-accent { opacity: 1; }

  .card-body {
    padding: 1.25rem 1.25rem 0.75rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .card-tag {
    font-family: var(--font-label);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid;
    white-space: nowrap;
  }

  .card-repo {
    font-family: 'Fira Code', monospace;
    font-size: 0.65rem;
    color: var(--muted);
    opacity: 0.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    letter-spacing: 0.03em;
    line-height: 1.1;
    color: var(--text);
    transition: color 0.2s;
  }
  .project-card:hover .card-title { color: var(--accent); }

  .card-excerpt {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 1.2vw, 0.82rem);
    color: var(--muted);
    line-height: 1.75;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 1.25rem;
    border-top: 0.5px solid rgba(255,255,255,0.05);
    margin-top: auto;
  }

  .card-read {
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.55;
    transition: opacity 0.2s;
  }
  .project-card:hover .card-read { opacity: 1; }

  .card-arrow {
    width: 13px; height: 13px;
    color: var(--accent);
    opacity: 0.55;
    transition: opacity 0.2s, transform 0.2s;
    flex-shrink: 0;
  }
  .project-card:hover .card-arrow { opacity: 1; transform: translateX(3px); }



  /* Empty state */
  .empty {
    text-align: center;
    padding: 4rem 2rem;
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ── Footer ── */
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 1.5rem clamp(1rem, 5vw, 3rem);
    border-top: 0.5px solid var(--border);
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .dim { opacity: 0.4; }

  @media (max-width: 480px) {
    footer { justify-content: center; text-align: center; }
  }
</style>
