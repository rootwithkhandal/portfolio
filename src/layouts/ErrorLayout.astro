---
interface Props {
  code: number;
  title: string;
  message: string;
  hint: string;
}
const { code, title, message, hint } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{code} — {title} · Priyansh Khandal</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Rajdhani:wght@400;600&family=Space+Grotesk:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>

  <!-- scanline overlay -->
  <div class="scanlines" aria-hidden="true"></div>

  <main>
    <!-- glitch code -->
    <div class="error-code" aria-hidden="true">{code}</div>

    <div class="content">
      <div class="tag">
        <span class="dot"></span>
        SYSTEM ERROR · {code}
      </div>

      <h1 class="title">{title}</h1>
      <p class="message">{message}</p>
      <p class="hint">{hint}</p>

      <div class="actions">
        <a href="/" class="btn-primary">← Return Home</a>
        <a href="/#projects" class="btn-ghost">Projects</a>
        <a href="/#contact" class="btn-ghost">Contact</a>
      </div>

      <!-- terminal block -->
      <div class="terminal">
        <div class="terminal-bar">
          <span class="t-dot r"></span>
          <span class="t-dot y"></span>
          <span class="t-dot g"></span>
          <span class="t-title">bash — khandal.tech</span>
        </div>
        <div class="terminal-body">
          <p><span class="prompt">$</span> curl -I khandal.tech{Astro.url.pathname}</p>
          <p class="out">HTTP/2 <span class="err">{code}</span></p>
          <p class="out">content-type: text/html</p>
          <p class="out">server: khandal.tech</p>
          <p class="out">&nbsp;</p>
          <p><span class="prompt">$</span> <span class="cursor-blink">▋</span></p>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <a href="/" class="logo">0x</a>
    <span>Priyansh Khandal · 2026</span>
  </footer>

</body>
</html>

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg:     #060c14;
    --accent: #4fc3f7;
    --red:    #e53935;
    --text:   #e8eaf0;
    --muted:  #6b7a8d;
    --border: rgba(79,195,247,0.15);
    --font-display: 'Bebas Neue', sans-serif;
    --font-label:   'Rajdhani', sans-serif;
    --font-body:    'Space Grotesk', sans-serif;
  }

  html { font-size: 110%; scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* CRT scanlines */
  .scanlines {
    position: fixed; inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.03) 2px,
      rgba(0,0,0,0.03) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 8vw, 5rem) clamp(1rem, 5vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  /* Giant background code number */
  .error-code {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(12rem, 35vw, 32rem);
    color: rgba(79,195,247,0.03);
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    animation: glitch 6s infinite;
  }

  @keyframes glitch {
    0%, 90%, 100% { transform: translate(-50%, -50%); opacity: 1; }
    91%  { transform: translate(-50%, -50%) translate(-4px, 0); opacity: 0.8; }
    92%  { transform: translate(-50%, -50%) translate(4px, 0);  opacity: 0.8; }
    93%  { transform: translate(-50%, -50%); opacity: 1; }
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    width: 100%;
  }

  /* Tag */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 1.5rem;
  }
  .dot {
    width: 6px; height: 6px;
    background: var(--red);
    border-radius: 50%;
    animation: pulse 1.5s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(1.5); }
  }

  /* Title */
  .title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: 0.03em;
    line-height: 1;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .message {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 0.5rem;
  }

  .hint {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(79,195,247,0.5);
    margin-bottom: 2.5rem;
  }

  /* Actions */
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn-primary {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    text-decoration: none;
    padding: 8px 20px;
    border-radius: 2px;
    transition: opacity 0.2s, transform 0.2s;
  }
  .btn-primary:hover { opacity: 0.85; transform: translateY(-1px); }

  .btn-ghost {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    padding: 8px 20px;
    border: 1px solid rgba(79,195,247,0.3);
    border-radius: 2px;
    background: rgba(79,195,247,0.05);
    transition: background 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover { background: rgba(79,195,247,0.12); border-color: rgba(79,195,247,0.6); }

  /* Terminal */
  .terminal {
    border: 0.5px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
    background: #040a10;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: rgba(255,255,255,0.04);
    border-bottom: 0.5px solid var(--border);
  }
  .t-dot {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .t-dot.r { background: #e53935; }
  .t-dot.y { background: #fdd835; }
  .t-dot.g { background: #43a047; }
  .t-title {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: var(--muted);
    margin-left: 4px;
  }

  .terminal-body {
    padding: 1rem 1.25rem;
    font-family: 'Fira Code', 'Cascadia Code', monospace;
    font-size: clamp(0.7rem, 1.2vw, 0.78rem);
    line-height: 1.8;
  }
  .terminal-body p { color: var(--muted); }
  .prompt { color: var(--accent); margin-right: 8px; }
  .out { padding-left: 1rem; }
  .err { color: var(--red); font-weight: 600; }

  .cursor-blink {
    color: var(--accent);
    animation: blink 1s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* Footer */
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem clamp(1rem, 5vw, 3rem);
    border-top: 0.5px solid var(--border);
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    color: rgba(79,195,247,0.4);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .actions { flex-direction: column; }
    .btn-primary, .btn-ghost { text-align: center; }
  }
</style>
