---
interface Props {
  code: number;
  title: string;
  message: string;
  hint: string;
}
const { code, title, message, hint } = Astro.props;

const currentYear = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{code} - {title} · Priyansh Khandal</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Source+Code+Pro:ital,wght@0,200..900;1,200..900&display=swap" rel="stylesheet" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>

  <!-- scanline overlay -->
  <div class="scanlines" aria-hidden="true"></div>

  <main>
    <!-- glitch code -->
    <div class="error-code" aria-hidden="true">{code}</div>

    <div class="content">
      <div class="tag">
        <span class="dot"></span>
        SYSTEM ERROR · {code}
      </div>

      <h1 class="title">{title}</h1>
      <p class="message">{message}</p>
      <p class="hint">{hint}</p>

      <div class="actions">
        <a href="/" class="btn-primary">← Return Home</a>
        <a href="/#projects" class="btn-ghost">Projects</a>
        <a href="/#contact" class="btn-ghost">Contact</a>
      </div>


    </div>
  </main>

    <footer>
    <div class="footer-left">
      <a href="/" class="logo" style="text-decoration:none; color:inherit;">0x</a>
      <span style="opacity:0.8;">Priyansh Khandal</span>
    </div>
    <div class="footer-legal" style="display:flex; gap:1rem; opacity:0.8;">
      <a href="/privacy" style="color:inherit; text-decoration:none;">Privacy</a>
      <a href="/tos" style="color:inherit; text-decoration:none;">Terms</a>
      <a href="/cookie-policy" style="color:inherit; text-decoration:none;">Cookies</a>
    </div>
    <span class="dim" style="opacity:0.5;">{currentYear}</span>
  </footer>

</body>
</html>

<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg:     #001e2b;
    --accent: #00ed64;
    --accent-rgb: 0, 237, 100;
    --accent-hover: #00b545;
    --red:    #ff8a80;
    --text:   #ffffff;
    --muted:  #a8b3bc;
    --border: rgba(0,237,100,0.15);
    --font-display: 'DM Sans', sans-serif;
    --font-label:   'DM Sans', sans-serif;
    --font-body:    'DM Sans', sans-serif;
  }

  html { font-size: 110%; scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* CRT scanlines */
  .scanlines {
    position: fixed; inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.03) 2px,
      rgba(0,0,0,0.03) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 8vw, 5rem) clamp(1rem, 5vw, 3rem);
    position: relative;
    overflow: hidden;
  }

  /* Giant background code number */
  .error-code {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-display);
    font-size: clamp(12rem, 35vw, 32rem);
    color: rgba(0,237,100,0.03);
    letter-spacing: -0.02em;
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
    animation: glitch 6s infinite;
  }

  @keyframes glitch {
    0%, 90%, 100% { transform: translate(-50%, -50%); opacity: 1; }
    91%  { transform: translate(-50%, -50%) translate(-4px, 0); opacity: 0.8; }
    92%  { transform: translate(-50%, -50%) translate(4px, 0);  opacity: 0.8; }
    93%  { transform: translate(-50%, -50%); opacity: 1; }
  }

  .content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    width: 100%;
  }

  /* Tag */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 1.5rem;
  }
  .dot {
    width: 6px; height: 6px;
    background: var(--red);
    border-radius: 50%;
    animation: pulse 1.5s infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%       { opacity: 0.4; transform: scale(1.5); }
  }

  /* Title */
  .title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 5rem);
    letter-spacing: 0.03em;
    line-height: 1;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .message {
    font-family: var(--font-body);
    font-size: clamp(0.85rem, 1.5vw, 0.95rem);
    color: var(--muted);
    line-height: 1.75;
    margin-bottom: 0.5rem;
  }

  .hint {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(0,237,100,0.5);
    margin-bottom: 2.5rem;
  }

  /* Actions */
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn-primary {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    text-decoration: none;
    padding: 8px 20px;
    border-radius: 9999px;
    transition: opacity 0.2s, transform 0.2s;
  }
  .btn-primary:hover { opacity: 0.85; transform: translateY(-1px); }

  .btn-ghost {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    padding: 8px 20px;
    border: 1px solid rgba(0,237,100,0.3);
    border-radius: 9999px;
    background: rgba(0,237,100,0.05);
    transition: background 0.2s, border-color 0.2s;
  }
  .btn-ghost:hover { background: rgba(0,237,100,0.12); border-color: rgba(0,237,100,0.6); }


  /* Footer */
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem clamp(1rem, 5vw, 3rem);
    border-top: 0.5px solid var(--border);
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logo {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    color: rgba(0,237,100,0.4);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .actions { flex-direction: column; }
    .btn-primary, .btn-ghost { text-align: center; }
  }
</style>
