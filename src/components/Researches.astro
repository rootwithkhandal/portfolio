---
import { researches } from '../data/researches';
---

<div id="researches">
  <div class="section-inner">
    <div class="researches-header">
      <div>
        <div class="section-label reveal d1">Writing</div>
        <div class="section-title reveal d2" style="margin-bottom:0">Field Notes</div>
      </div>
      <a href="/researches" class="researches-all reveal d2">All Posts →</a>
    </div>

    <div class="research-grid">
      {researches.map(({ slug, tag, tagColor, title, excerpt, date, readTime }, i) => (
        <a href={`/researches/${slug}`} class={`research-card reveal d${(i % 3) + 1}`}>
          <div class="research-card-top">
            <span class="research-tag" style={`color:${tagColor};border-color:${tagColor}30;background:${tagColor}0d`}>
              {tag}
            </span>
            <span class="research-meta">{date} · {readTime} read</span>
          </div>

          <h3 class="research-title">{title}</h3>
          <p class="research-excerpt">{excerpt}</p>

          <div class="research-footer">
            <span class="research-read-link">Read Article</span>
            <svg class="research-arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

        </a>
      ))}
    </div>
  </div>
</div>

<style>
  #researches {
    background: var(--bg2);
    padding: clamp(4rem, 8vw, 6rem) 0;
  }

  .researches-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .researches-all {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .researches-all:hover { opacity: 1; }

  .research-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .research-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    background: var(--bg3);
    border: 0.5px solid rgba(255,255,255,0.07);
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s, transform 0.3s, background 0.3s;
    overflow: hidden;
  }
  .research-card:hover {
    border-color: rgba(0,237,100,0.3);
    background: rgba(0,237,100,0.03);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2), 0 0 0 1px rgba(0,237,100,0.1);
  }

  .research-corner {
    position: absolute;
    width: 14px; height: 14px;
    border-color: rgba(0,237,100,0.25);
    border-style: solid;
    transition: border-color 0.3s;
  }
  .research-corner.tl { top: 0; left: 0;     border-width: 1px 0 0 1px; }
  .research-corner.br { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
  .research-card:hover .research-corner { border-color: rgba(0,237,100,0.6); }

  .research-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .research-tag {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 4px;
    border: 1px solid;
    white-space: nowrap;
  }

  .research-meta {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .research-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: 0.03em;
    line-height: 1.15;
    color: var(--text);
    transition: color 0.2s;
  }
  .research-card:hover .research-title { color: var(--accent); }

  .research-excerpt {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 1.2vw, 0.82rem);
    color: var(--muted);
    line-height: 1.75;
    flex: 1;
  }

  .research-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 0.5px solid rgba(255,255,255,0.06);
  }

  .research-read-link {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .research-card:hover .research-read-link { opacity: 1; }

  .research-arrow {
    width: 14px; height: 14px;
    color: var(--accent);
    opacity: 0.6;
    transition: opacity 0.2s;
    flex-shrink: 0;
  }
  .research-card:hover .research-arrow { opacity: 1; }

  @media (max-width: 599px)  { .research-grid { grid-template-columns: 1fr; } .research-card { padding: 1.2rem; } }
</style>
