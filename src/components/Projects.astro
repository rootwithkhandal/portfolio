---

<div id="projects">
  <div class="section-inner">
    <div class="projects-header">
      <div>
        <div class="section-label reveal d1">Research &amp; Projects</div>
        <div class="section-title reveal d2" style="margin-bottom:0">Active Operations</div>
      </div>
      <div class="projects-right reveal d2">
        <div class="projects-badge">Zero AI Assist</div>
        <a
          href="/projects"
          class="projects-all-btn"
        >
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          All Projects
        </a>
      </div>
    </div>

    <div class="project-grid">
      {projects.map((project, i) => {
        const meta = cardMeta[project.slug] ?? { cls: 'p1', svg: '' };
        return (
          <a
            href={`/projects/${project.slug}`}
            class={`project-card ${meta.cls} reveal d${(i % 4) + 1}`}
          >
            <div class="project-img-bg" style={meta.style ?? ''} set:html={meta.svg} />
            <div class="project-tag">{project.tag}</div>
            <div class="project-overlay"><div class="project-label">{project.title}</div></div>
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  #projects {
    background: var(--bg3);
    padding: clamp(4rem, 8vw, 6rem) 0;
  }

  .projects-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .projects-right {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .projects-badge {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    padding: 5px 12px;
    border-radius: 2px;
    white-space: nowrap;
  }

  .projects-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    padding: 6px 14px;
    border: 1px solid rgba(255,200,50,0.3);
    border-radius: 2px;
    background: rgba(255,200,50,0.05);
    transition: background 0.2s, border-color 0.2s, transform 0.2s;
    white-space: nowrap;
  }
  .projects-all-btn:hover {
    background: rgba(255,200,50,0.12);
    border-color: rgba(255,200,50,0.6);
    transform: translateY(-1px);
  }
  .projects-all-btn svg { width: 14px; height: 14px; fill: var(--accent); flex-shrink: 0; }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 200px);
    gap: 8px;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    cursor: pointer;
    background: var(--bg2);
    border: 0.5px solid rgba(255,255,255,0.06);
    text-decoration: none;
    transition: border-color 0.3s;
    display: block;
  }
  .project-card:hover { border-color: rgba(255,200,50,0.3); }
  .project-card:hover .project-overlay { opacity: 1; }
  .project-card:hover .project-img-bg  { transform: scale(1.05); }

  .project-card.span-v { grid-row: span 2; }
  .project-card.span-h { grid-column: span 2; }

  .project-img-bg {
    position: absolute; inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1);
  }

  .project-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(6,12,20,0.9) 0%, transparent 60%);
    opacity: 0;
    transition: opacity 0.3s;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .project-label {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .project-tag {
    position: absolute;
    top: 10px; right: 10px;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    background: rgba(6,12,20,0.7);
    border: 0.5px solid rgba(255,255,255,0.1);
    padding: 3px 8px;
    border-radius: 2px;
  }

  :global(.card-deco) { position: absolute; inset: 0; opacity: 0.6; }

  .p1 { background: linear-gradient(135deg, #0d2235 0%, #1a1a2e 100%); }
  .p2 { background: linear-gradient(135deg, #1a0d0d 0%, #2d1a1a 100%); }
  .p3 { background: linear-gradient(135deg, #0d1a0d 0%, #1a2d1a 100%); }
  .p4 { background: linear-gradient(135deg, #1a1a0d 0%, #2d2d1a 100%); }
  .p5 { background: linear-gradient(135deg, #1a0d1a 0%, #2d1a2d 100%); }
  .p6 { background: linear-gradient(135deg, #0d1a1a 0%, #1a2d2d 100%); }
  .p7 { background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); }
  .p8 { background: linear-gradient(135deg, #0d0d1a 0%, #1a1a2d 100%); }

  @media (max-width: 1023px) {
    .project-grid { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 180px); }
  }
  @media (max-width: 899px) {
    .project-grid { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(4, 160px); }
    .project-card.span-h { grid-column: span 1; }
    .project-card.span-v { grid-row: span 1; }
  }
  @media (max-width: 599px) {
    .project-grid { grid-template-columns: 1fr; grid-template-rows: auto; }
    .project-card { min-height: 130px; }
  }
</style>
