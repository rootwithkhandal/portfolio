---
const skills = [
  { label: 'Burp Suite Pro',    color: '#e53935' },
  { label: 'Linux',             color: '#4fc3f7' },
  { label: 'Python',            color: '#69f0ae' },
  { label: 'Foundry',           color: '#ff9800' },
  { label: 'Ollama / LLMs',     color: '#ce93d8' },
  { label: 'WireGuard',         color: '#80cbc4' },
  { label: 'Slither',           color: '#f06292' },
  { label: 'ProjectDiscovery',  color: '#4dd0e1' },
];

const proficiency = [
  { label: 'SOC / Blue', pct: 85 },
  { label: 'AI / MLSec', pct: 75 },
  { label: 'Blockchain', pct: 80 },
  { label: 'Offensive', pct: 65 },
];

const certificates = [
  {
    name: 'Certified SOC Analyst (CSA)',
    issuer: 'EC-Council',
    year: '2026',
    color: '#4fc3f7',
    url: 'https://www.eccouncil.org/programs/certified-soc-analyst-csa/',
  },
  {
    name: 'IBM Cybersecurity Analyst Certificate',
    issuer: 'IBM / Coursera',
    year: '2025',
    color: '#69f0ae',
    url: 'https://grow.google/certificates/cybersecurity/',
  },
  {
    name: 'Cybersecurity 101',
    issuer: 'TryHackMe',
    year: '2025',
    color: '#ff9800',
    url: 'https://tryhackme.com/path/outline/jrpenetrationtester',
  },
  {
    name: 'AI for Anomaly Detection',
    issuer: 'Nvidia',
    year: '2025',
    color: '#ce93d8',
    url: 'https://tryhackme.com/path/outline/web',
  },
  {
    name: 'Blockchain Security Basics',
    issuer: 'Immunefi',
    year: '2025',
    color: '#f06292',
    url: 'https://immunefi.com',
  },
  {
    name: 'Introduction to AI Red-Teaming',
    issuer: 'Microsoft / PyRIT',
    year: '2025',
    color: '#80cbc4',
    url: 'https://github.com/Azure/PyRIT',
  },
];
---

<div id="profile">
  <div class="section-inner">
    <div class="section-label reveal d1">Profile</div>

    <div class="profile-grid">
      <!-- Avatar column -->
      <div class="profile-avatar-wrap reveal d2">
        <div class="profile-photo-box">
          <img src="/profile.png" alt="Priyansh Khandal" class="profile-photo-img" />
          <div class="profile-photo-glow"></div>
          <div class="profile-name-tag">
            <h3>Hello, I am</h3>
            <p>PRIYANSH</p>
          </div>
        </div>
      </div>

      <!-- Info column -->
      <div class="profile-info">
        <h2 class="reveal d2">About Me</h2>
        <p class="profile-bio reveal d3">
          Cybersecurity student, SOC analyst, and penetration tester with a hacker's mindset
          and a strategist's discipline. My work spans bug bounty hunting, AI red-teaming with
          Garak/PyRIT, and blockchain smart contract auditing on Immunefi and Code4rena.
          Environments are declarative, terminal-native, and operationally compartmentalized by design.
        </p>

        <div class="skills-title reveal d3">Technical Stack</div>
        <div class="skills-icons reveal d4">
          {skills.map(({ label, color }) => (
            <div class="skill-pill">
              <div class="skill-dot" style={`background:${color}`}></div>
              {label}
            </div>
          ))}
        </div>

        <div class="profile-meta">
          <div class="meta-block reveal d4">
            <div class="meta-label">Education</div>
            <div class="meta-item">
              <strong>Masters of Computer Applications - Pursuing</strong>
              <span>Active Student</span>
              <span>Specialization: Cyber Security &amp; AI Safety</span>
            </div>
          </div>
          <div class="meta-block reveal d5">
            <div class="meta-label">Certifications &amp; Programs</div>
            <div class="meta-item">
              <strong>Bug Bounty · SOC Operations</strong>
              <span>Certified SOC Analyst · Code4rena · Sherlock</span>
              <span>TryHackMe · HackTheBox</span>
            </div>
          </div>
          <div class="meta-block span-full reveal d6">
            <div class="meta-label">Operational Proficiency</div>
            <div class="lang-bar-wrap">
              {proficiency.map(({ label, pct }) => (
                <div class="lang-row">
                  <span class="lang-name">{label}</span>
                  <div class="lang-bar">
                    <div class="lang-fill" data-width={pct} style="width:0%"></div>
                  </div>
                  <span class="lang-pct">{pct}%</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Certificates -->
        <div class="certs-wrap reveal d7">
          <div class="meta-label" style="margin-bottom:1rem">Certificates &amp; Credentials</div>
          <div class="certs-grid">
            {certificates.map(({ name, issuer, year, color, url }) => (
              <a href={url} target="_blank" rel="noopener noreferrer" class="cert-card">
                <div class="cert-bar" style={`background:${color}`}></div>
                <div class="cert-body">
                  <div class="cert-issuer" style={`color:${color}`}>{issuer} · {year}</div>
                  <div class="cert-name">{name}</div>
                </div>
                <svg class="cert-arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 12L12 4M12 4H6M12 4v6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #profile {
    background: var(--bg2);
    padding: clamp(4rem, 8vw, 6rem) 0;
  }

  .profile-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: 2rem;
  }

  .profile-photo-box {
    width: 100%;
    aspect-ratio: 3/4;
    border-radius: 2px;
    border: 0.5px solid var(--border);
    overflow: hidden;
    position: relative;
  }

  .profile-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .profile-photo-glow {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 50% 80%, rgba(229,57,53,0.15) 0%, transparent 70%);
  }
  .profile-name-tag {
    position: absolute;
    bottom: -1px; left: 0; right: 0;
    background: rgba(6,12,20,0.85);
    border-top: 1px solid var(--border);
    padding: 12px 16px;
    text-align: center;
  }
  .profile-name-tag h3 {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2px;
  }
  .profile-name-tag p {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.12em;
    color: var(--text);
  }

  /* Info */
  .profile-info h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .profile-bio {
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 1.4vw, 0.875rem);
    color: var(--muted);
    line-height: 1.9;
    margin-bottom: 2.5rem;
    max-width: 480px;
  }

  .skills-title {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .skills-icons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(79,195,247,0.06);
    border: 1px solid rgba(79,195,247,0.18);
    border-radius: 3px;
    padding: 6px 12px;
    font-family: var(--font-label);
    font-size: clamp(0.7rem, 1.3vw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent);
    transition: background 0.2s, border-color 0.2s;
    cursor: default;
  }
  .skill-pill:hover {
    background: rgba(79,195,247,0.12);
    border-color: rgba(79,195,247,0.4);
  }
  .skill-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Meta grid */
  .profile-meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .span-full { grid-column: span 2; }

  .meta-label {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .meta-label::before {
    content: '';
    display: block;
    width: 4px; height: 4px;
    background: var(--accent);
    border-radius: 50%;
    flex-shrink: 0;
  }
  .meta-item {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 1.3vw, 0.82rem);
    color: var(--muted);
    line-height: 1.9;
    padding-left: 12px;
  }
  .meta-item strong {
    font-family: var(--font-body);
    color: var(--text);
    font-weight: 500;
    display: block;
    font-size: 0.84rem;
  }

  /* Proficiency bars */
  .lang-bar-wrap { margin-top: 0.4rem; }
  .lang-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    font-family: var(--font-body);
    font-size: clamp(0.7rem, 1.3vw, 0.78rem);
    color: var(--muted);
  }
  .lang-name { width: 72px; flex-shrink: 0; }
  .lang-pct  { width: 34px; text-align: right; color: var(--text); font-size: 0.72rem; flex-shrink: 0; }
  .lang-bar {
    flex: 1;
    height: 2px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: hidden;
  }
  .lang-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 2px;
    transition: width 1.2s cubic-bezier(0.16,1,0.3,1);
  }

  /* Responsive */
  @media (max-width: 899px) {
    .profile-grid { grid-template-columns: 1fr; }
    .profile-photo-box { max-width: 280px; margin: 0 auto; }
    .profile-bio { max-width: 100%; }
  }
  @media (max-width: 599px) {
    .profile-meta { grid-template-columns: 1fr; }
    .span-full { grid-column: span 1; }
  }

  /* Certificates */
  .certs-wrap { margin-top: 2.5rem; }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .cert-card {
    display: flex;
    align-items: center;
    gap: 0;
    background: var(--bg3);
    border: 0.5px solid rgba(255,255,255,0.07);
    border-radius: 3px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: border-color 0.3s, transform 0.3s, background 0.3s;
  }
  .cert-card:hover {
    border-color: rgba(79,195,247,0.3);
    background: rgba(79,195,247,0.03);
    transform: translateY(-2px);
  }

  .cert-bar {
    width: 3px;
    align-self: stretch;
    flex-shrink: 0;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  .cert-card:hover .cert-bar { opacity: 1; }

  .cert-body {
    flex: 1;
    padding: 0.75rem 0.85rem;
    min-width: 0;
  }

  .cert-issuer {
    font-family: var(--font-label);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 3px;
    opacity: 0.85;
  }

  .cert-name {
    font-family: var(--font-body);
    font-size: clamp(0.72rem, 1.1vw, 0.78rem);
    color: var(--text);
    line-height: 1.35;
    font-weight: 500;
  }

  .cert-arrow {
    width: 13px; height: 13px;
    color: var(--muted);
    flex-shrink: 0;
    margin-right: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s, transform 0.2s;
  }
  .cert-card:hover .cert-arrow {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  @media (max-width: 1023px) {
    .certs-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 599px) {
    .certs-grid { grid-template-columns: 1fr; }
  }
</style>
