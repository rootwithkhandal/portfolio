---
import { blogs } from '../data/blogs';
---

<div id="blogs">
  <div class="section-inner">
    <div class="blogs-header">
      <div>
        <div class="section-label reveal d1">Writing</div>
        <div class="section-title reveal d2" style="margin-bottom:0">Field Notes</div>
      </div>
      <a href="/blogs" class="blogs-all reveal d2">All Posts →</a>
    </div>

    <div class="blog-grid">
      {blogs.map(({ slug, tag, tagColor, title, excerpt, date, readTime }, i) => (
        <a href={`/blogs/${slug}`} class={`blog-card reveal d${(i % 3) + 1}`}>
          <div class="blog-card-top">
            <span class="blog-tag" style={`color:${tagColor};border-color:${tagColor}30;background:${tagColor}0d`}>
              {tag}
            </span>
            <span class="blog-meta">{date} · {readTime} read</span>
          </div>

          <h3 class="blog-title">{title}</h3>
          <p class="blog-excerpt">{excerpt}</p>

          <div class="blog-footer">
            <span class="blog-read-link">Read Article</span>
            <svg class="blog-arrow" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <div class="blog-corner tl"></div>
          <div class="blog-corner br"></div>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  #blogs {
    background: var(--bg2);
    padding: clamp(4rem, 8vw, 6rem) 0;
  }

  .blogs-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .blogs-all {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  .blogs-all:hover { opacity: 1; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .blog-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    background: var(--bg3);
    border: 0.5px solid rgba(255,255,255,0.07);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s, transform 0.3s, background 0.3s;
    overflow: hidden;
  }
  .blog-card:hover {
    border-color: rgba(79,195,247,0.3);
    background: rgba(79,195,247,0.03);
    transform: translateY(-4px);
  }

  .blog-corner {
    position: absolute;
    width: 14px; height: 14px;
    border-color: rgba(79,195,247,0.25);
    border-style: solid;
    transition: border-color 0.3s;
  }
  .blog-corner.tl { top: 0; left: 0;     border-width: 1px 0 0 1px; }
  .blog-corner.br { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
  .blog-card:hover .blog-corner { border-color: rgba(79,195,247,0.6); }

  .blog-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-tag {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 2px;
    border: 1px solid;
    white-space: nowrap;
  }

  .blog-meta {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .blog-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: 0.03em;
    line-height: 1.15;
    color: var(--text);
    transition: color 0.2s;
  }
  .blog-card:hover .blog-title { color: var(--accent); }

  .blog-excerpt {
    font-family: var(--font-body);
    font-size: clamp(0.75rem, 1.2vw, 0.82rem);
    color: var(--muted);
    line-height: 1.75;
    flex: 1;
  }

  .blog-footer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 0.5px solid rgba(255,255,255,0.06);
  }

  .blog-read-link {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.6;
    transition: opacity 0.2s;
  }
  .blog-card:hover .blog-read-link { opacity: 1; }

  .blog-arrow {
    width: 14px; height: 14px;
    color: var(--accent);
    opacity: 0.6;
    transition: opacity 0.2s, transform 0.2s;
    flex-shrink: 0;
  }
  .blog-card:hover .blog-arrow { opacity: 1; transform: translateX(3px); }

  @media (max-width: 1023px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px)  { .blog-grid { grid-template-columns: 1fr; } .blog-card { padding: 1.2rem; } }
</style>
